# Puerto de la API
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (frontend)
CORS_ORIGIN=http://localhost:8081

# Opción 1: cadena de conexión completa (tiene prioridad)
# DATABASE_URL=postgres://postgres:cambia_esta_clave@localhost:5432/autostory

# Opción 2: variables por separado (obligatorias si no hay DATABASE_URL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esta_clave
PGDATABASE=autostory

# Base de datos para los tests de integración (nunca la de desarrollo)
TEST_DATABASE_URL=postgres://postgres:cambia_esta_clave@localhost:5432/autostory_test
