# Entorno: development | test | production
NODE_ENV=development

# Puerto de la API
PORT=3000

# Base de datos PostgreSQL (obligatoria)
DATABASE_URL=postgres://postgres:cambia_esta_clave@localhost:5432/autostory

# SSL de la base de datos ("true" para Render y otros proveedores gestionados)
DATABASE_SSL=false

# Máximo de conexiones del pool
DATABASE_POOL_MAX=10

# Base de datos para los tests de integración (nunca la de desarrollo)
TEST_DATABASE_URL=postgres://postgres:cambia_esta_clave@localhost:5432/autostory_test

# Orígenes permitidos por CORS, separados por comas y sin barra final
CORS_ORIGIN=http://localhost:8081

# Autenticación: clerk (por defecto) o dev-header (solo fuera de producción)
AUTH_MODE=clerk

# Obligatorias con AUTH_MODE=clerk (nunca en el frontend)
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Orígenes autorizados por Clerk, separados por comas y sin barra final
# CLERK_AUTHORIZED_PARTIES=http://localhost:8081

# Trabajador de recordatorios (true/false) y frecuencia del bucle en segundos
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_SECONDS=60

# Carpeta de fotos (por defecto backend/uploads; en Render monta un disco aquí)
# UPLOADS_DIR=/var/data/uploads

# Almacenamiento de fotos: disk (desarrollo) o s3 (producción, compatible con R2)
STORAGE_DRIVER=disk
# Obligatorias con STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=autostory-fotos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# URL pública del bucket, sin barra final, p. ej. https://fotos.example.com
# S3_PUBLIC_BASE_URL=
