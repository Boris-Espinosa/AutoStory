{
  "expo": {
    "name": "AutoStory",
    "slug": "autostory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "autostory",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autostory.app"
    },
    "android": {
      "package": "com.autostory.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@clerk/expo",
        {
          "appleSignIn": true
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b47b3672-72f3-4725-8b59-e63c47168135"
      }
    }
  }
}
